# =============================================================================
# World Monitor Seeder Runner
# =============================================================================
# One-shot image for self-hosted Redis seed jobs. It runs scripts/run-seeders.sh
# inside the Compose network, writing to the redis-rest service.
# =============================================================================

FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2

RUN apk add --no-cache coreutils curl

WORKDIR /app

# Root dependencies cover seeders that import server/api/shared modules.
COPY package.json package-lock.json ./
RUN npm ci --include=dev --omit=optional --ignore-scripts

# scripts/ has its own package for relay/seeder-only dependencies such as sax.
COPY scripts/package.json scripts/package-lock.json ./scripts/
RUN npm ci --prefix scripts --omit=dev --omit=optional --ignore-scripts

COPY api ./api
COPY data ./data
COPY scripts ./scripts
COPY server ./server
COPY shared ./shared
COPY src ./src

RUN chmod +x ./scripts/run-seeders.sh

CMD ["./scripts/run-seeders.sh"]
